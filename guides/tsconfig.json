{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"noEmit": true,
		"types": ["vite/client", "node"],
		"lib": ["ES2022", "DOM", "DOM.Iterable"]
	},
	"include": ["src", "preview", "scripts", "vite.config.ts"]
}
